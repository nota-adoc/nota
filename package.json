{
  "name": "nota-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "quality",
    "demo"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "tsc -p packages/core/tsconfig.json && tsc -p packages/html/tsconfig.json && tsc -p packages/codemirror/tsconfig.json && tsc -p packages/prosemirror/tsconfig.json && tsc -p packages/react/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "fuzz": "tsx quality/fuzz/cli.ts",
    "bench": "tsx quality/bench/cli.ts",
    "dump": "tsx quality/dump.ts",
    "ref": "tsx quality/reference/cli.ts",
    "compare": "tsx quality/reference/compare-cli.ts",
    "corpus": "tsx quality/corpus/cli.ts",
    "tck": "tsx quality/tck/cli.ts",
    "check:browser": "tsx quality/check-browser.ts",
    "size": "tsx quality/size.ts",
    "notices": "tsx quality/notices.ts",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "vsix": "npm run vsix -w packages/vscode",
    "test:vscode": "npm run test:vscode -w packages/vscode",
    "test:vsix": "npm run test:vsix -w packages/vscode"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10.0.1",
    "@lezer/common": "^1.5.5",
    "@lezer/css": "^1.3.9",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@lezer/java": "^1.1.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@lezer/python": "^1.1.19",
    "@lezer/xml": "^1.0.6",
    "@lezer/yaml": "^1.0.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.9",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "mermaid": {
      "katex": "^0.18.2"
    },
    "minimatch@^10.0.0": "^11.0.1"
  }
}
